[Unit]
Description=YXHK marketing unsubscribe
After=network.target

[Service]
User=yxhk-unsubscribe
Group=yxhk-unsubscribe
Environment=YXHK_UNSUBSCRIBE_CONFIG=/etc/yxhk-unsubscribe/config.json
ExecStart=/usr/bin/python3 /opt/yxhk-unsubscribe/current/unsubscribe_server.py
Restart=on-failure
RestartSec=3
StateDirectory=yxhk-unsubscribe
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
