{% extends '@MauticCore/Default/content.html.twig' %}
{% block headerTitle %}客户回复{% endblock %}
{% block pageTitle %}客户回复{% endblock %}
{% block content %}
{% set token = csrf_token('yxhk_inbox') %}
<div class="pa-lg">
<div id="yxhk-inbox-feedback" class="alert hide" role="status" aria-live="polite"></div>
{% for message in notice %}<div class="alert alert-info">{{ message }}</div>{% endfor %}
<div class="panel panel-default"><div class="panel-body">
<h3>收件监控</h3>
<p>邮件仍保存在各自的原邮箱。此页只读取最近 20 封邮件的发件人、主题和时间，不读取正文，也不会把原邮箱的邮件标记为已读。请到对应邮箱处理和回复。</p>
<p>启用前，请在邮箱网页设置中打开 IMAP 服务；使用与 SMTP 对应的授权码。每个账号至少间隔 15 分钟检查一次，后台每分钟最多检查一个账号。账号越多，轮完一遍所需时间越长。登录失败会自动暂停该账号，避免反复尝试。</p>
<table class="table"><thead><tr><th>邮箱</th><th>状态</th><th>最近成功</th><th>操作</th></tr></thead><tbody>
{% for id, account in accounts %}
<tr><td>{{ account.email }}<br><small>{{ account.label }}</small></td>
<td class="yxhk-inbox-account-status">{{ account.state.status|default('未启用') }}</td>
<td>{{ account.state.last_success is defined ? account.state.last_success|date('Y-m-d H:i') : '尚未连接' }}</td>
<td><form class="yxhk-inbox-account-form" method="post" action="{{ path('yxhk_inbox') }}">
<input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="account"><input type="hidden" name="id" value="{{ id }}">
<input type="hidden" name="enabled" value="{{ account.state.enabled|default(false) ? '0' : '1' }}">
<button class="btn btn-sm {{ account.state.enabled|default(false) ? 'btn-default' : 'btn-primary' }}" type="submit" {{ not account.configured ? 'disabled' }}>{{ account.state.enabled|default(false) ? '关闭监控' : '启用监控' }}</button>
<a class="btn btn-sm btn-default" href="{{ account.type == '163' ? 'https://mail.163.com/' : 'https://mail.126.com/' }}" target="_blank" rel="noopener noreferrer">打开原邮箱</a>
</form></td></tr>
{% endfor %}
</tbody></table>
</div></div>
<div class="panel panel-default"><div class="panel-body"><h3>最近收到的邮件</h3>
<p>“已处理”只改变本页标记，不会移动或删除原邮箱中的邮件。</p>
<table class="table"><thead><tr><th>时间</th><th>收到的邮箱</th><th>发件人</th><th>主题</th><th>状态</th></tr></thead><tbody>
{% for key, message in messages %}
<tr><td>{{ message.received_at|date('Y-m-d H:i') }}</td><td>{{ accounts[message.profile_id].email }}</td><td>{{ message.from }}</td><td>{{ message.subject ?: '（无主题）' }}</td>
<td><form method="post" action="{{ path('yxhk_inbox') }}"><input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="handled"><input type="hidden" name="id" value="{{ key }}"><input type="hidden" name="handled" value="{{ message.handled ? '0' : '1' }}"><button class="btn btn-sm btn-default" type="submit">{{ message.handled ? '已处理，改为待处理' : '待处理，标记完成' }}</button></form></td></tr>
{% else %}<tr><td colspan="5">暂无收件记录。启用账号并等待首次检查后显示。</td></tr>{% endfor %}
</tbody></table></div></div>
</div>
{% endblock %}
