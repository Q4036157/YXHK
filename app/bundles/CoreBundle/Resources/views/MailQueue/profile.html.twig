<form method="post" action="{{ path('yxhk_mail_queue') }}" autocomplete="off" class="pa-md">
<input type="hidden" name="_token" value="{{ token }}"><input type="hidden" name="action" value="profile"><input type="hidden" name="profile_id" value="{{ id }}">
<div class="row">{% for field, label in {'label':'账号名称','host':'SMTP 主机（留空使用类型默认值）','port':'SMTP 端口（留空使用类型默认值）','username':'登录邮箱','from':'发件邮箱','name':'发件人名称'} %}<div class="col-md-6 form-group"><label>{{ label }}</label><input class="form-control" name="{{ field }}" value="{{ attribute(profile, field)|default('') }}" {{ field in ['username','from','label'] ? 'required' : '' }}></div>{% endfor %}</div>
<div class="form-group"><label>邮箱类型</label><select class="form-control" name="type">{% for value, label in types %}<option value="{{ value }}" {{ profile.type|default('qq') == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
<div class="form-group"><label>加密方式</label><select name="security" class="form-control"><option value="smtps" {{ profile.security|default('smtps') == 'smtps' ? 'selected' : '' }}>SSL/TLS（通常端口 465）</option><option value="starttls" {{ profile.security|default('') == 'starttls' ? 'selected' : '' }}>STARTTLS（通常端口 587）</option></select></div>
<div class="form-group"><label>认证方式</label><select name="auth" class="form-control"><option value="password" {{ profile.auth|default('password') == 'password' ? 'selected' : '' }}>SMTP 授权码 / 应用专用密码</option><option value="oauth2" {{ profile.auth|default('') == 'oauth2' ? 'selected' : '' }}>OAuth 2.0（谷歌 / Outlook）</option></select></div>
<div class="form-group"><label>SMTP 授权码（留空保留）</label><input class="form-control" type="password" name="password" autocomplete="new-password"></div>
<details><summary>OAuth 2.0 授权信息</summary>{% for field, label in {'oauth_client_id':'应用客户端 ID','oauth_client_secret':'应用客户端密钥（公开客户端可留空）','oauth_refresh_token':'刷新令牌'} %}<div class="form-group"><label>{{ label }}（留空保留）</label><input class="form-control" type="password" name="{{ field }}" autocomplete="new-password"></div>{% endfor %}<p>请使用已取得 SMTP 发送权限的授权信息；谷歌使用 mail.google.com 权限，Outlook 使用 SMTP.Send 和 offline_access 权限。</p></details>
<p><label><input type="checkbox" name="enabled" value="1" {{ profile.enabled|default(false) ? 'checked' : '' }}> 启用此账号</label></p>
<button type="submit" class="btn btn-default">保存发件账号</button>
</form>
